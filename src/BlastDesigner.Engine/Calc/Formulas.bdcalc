{
  // Встроенный профиль расчёта: формулы повторяют код Charging, Quantities, Prediction (до движка вычислений).
  // Только для чтения: свои формулы.
  "name": "Calc v1",
  "version": "1.0",
  "readOnly": true,
  "description": "Расчёты Blast Designer 6: заряжание, объёмы и итоги, стоимость, удельный расход и энергия, сейсмика, воздушная волна, разлёт, фрагментация, опасная зона.",
  "parameters": [
    { "id": "site.vib.K", "nameRu": "Сейсмика: K", "nameEn": "PPV site constant K", "unit": "?", "value": 1140, "bind": "Vibration.SiteK", "builtIn": true },
    { "id": "site.vib.B", "nameRu": "Сейсмика: B", "nameEn": "PPV attenuation B", "unit": "1", "value": 1.6, "bind": "Vibration.SiteB", "builtIn": true },
    { "id": "site.vib.airK", "nameRu": "Воздушная волна: K", "nameEn": "Airblast constant", "unit": "?", "value": 10, "bind": "Vibration.AirK", "builtIn": true },
    { "id": "site.vib.airB", "nameRu": "Воздушная волна: B", "nameEn": "Airblast attenuation", "unit": "1", "value": 1.45, "bind": "Vibration.AirB", "builtIn": true },
    { "id": "site.vib.window", "nameRu": "Окно МВЗ", "nameEn": "MIC window", "unit": "ms", "value": 8, "bind": "Vibration.WindowMs", "builtIn": true },
    { "id": "site.vib.ppvLimit", "nameRu": "Допустимая скорость колебаний", "nameEn": "PPV limit", "unit": "mm/s", "value": 10, "bind": "Vibration.PpvLimit", "builtIn": true },
    { "id": "site.vib.airblastLimit", "nameRu": "Допустимая воздушная волна", "nameEn": "Airblast limit", "unit": "dB", "value": 120, "bind": "Vibration.AirblastLimitDb", "builtIn": true },
    { "id": "site.flyrock.K", "nameRu": "Разлёт: k", "nameEn": "Flyrock constant k", "unit": "?", "value": 13.5, "bind": "Flyrock.SiteK", "builtIn": true },
    { "id": "site.flyrock.safetyFactor", "nameRu": "Разлёт: запас", "nameEn": "Flyrock safety factor", "unit": "1", "value": 2, "bind": "Flyrock.SafetyFactor", "builtIn": true },
    { "id": "site.flyrock.minClearance", "nameRu": "Наименьшая опасная зона", "nameEn": "Minimum clearance", "unit": "m", "value": 300, "bind": "Flyrock.MinimumClearance", "builtIn": true },
    { "id": "site.frag.rockFactor", "nameRu": "Фактор породы A", "nameEn": "Rock factor A", "unit": "?", "value": 8, "bind": "Fragmentation.RockFactor", "builtIn": true },
    { "id": "site.frag.rockFactorSet", "nameRu": "A задан явно (1/0)", "nameEn": "Rock factor set", "unit": "1", "value": 0, "bind": "Fragmentation.RockFactorSet", "builtIn": true },
    { "id": "site.frag.rockMassDescription", "nameRu": "RMD", "nameEn": "Rock mass description", "unit": "?", "value": 50, "bind": "Fragmentation.RockMassDescription", "builtIn": true },
    { "id": "site.frag.jointFactor", "nameRu": "JF", "nameEn": "Joint factor", "unit": "?", "value": 0, "bind": "Fragmentation.JointFactor", "builtIn": true },
    { "id": "site.frag.ucs", "nameRu": "Прочность на сжатие, МПа", "nameEn": "UCS, MPa", "unit": "?", "value": 120, "bind": "Fragmentation.Ucs", "builtIn": true },
    { "id": "site.frag.youngsModulus", "nameRu": "Модуль Юнга, ГПа", "nameEn": "Young modulus, GPa", "unit": "?", "value": 50, "bind": "Fragmentation.YoungsModulus", "builtIn": true },
    { "id": "site.frag.drillDeviation", "nameRu": "Отклонение бурения", "nameEn": "Drilling deviation", "unit": "m", "value": 0.2, "bind": "Fragmentation.DrillDeviation", "builtIn": true },
    { "id": "site.frag.oversize", "nameRu": "Негабарит от", "nameEn": "Oversize size", "unit": "cm", "value": 100, "bind": "Fragmentation.OversizeCm", "builtIn": true },
    { "id": "site.frag.fines", "nameRu": "Мелочь до", "nameEn": "Fines size", "unit": "cm", "value": 2, "bind": "Fragmentation.FinesCm", "builtIn": true }
  ],
  "properties": [
    { "id": "deck.mass", "min": 0, "max": 5000, "nameRu": "Масса", "nameEn": "Mass", "unit": "kg", "group": "Заряжание", "format": "0.0", "builtIn": true },
    { "id": "deck.kgPerMetre", "nameRu": "Масса на метр", "nameEn": "Charge per metre", "unit": "kg/m", "group": "Заряжание", "format": "0.00", "builtIn": true },
