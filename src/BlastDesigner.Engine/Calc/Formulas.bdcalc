    { "id": "hole.benchHeight", "nameRu": "Высота по вертикали", "nameEn": "Vertical bench height", "unit": "m", "group": "Объёмы", "format": "0.00", "builtIn": true },
    { "id": "hole.volume", "min": 0, "max": 20000, "nameRu": "Объём", "nameEn": "Volume", "unit": "m3", "group": "Объёмы", "format": "0.0", "builtIn": true },
    { "id": "hole.rockDensity", "nameRu": "Плотность породы", "nameEn": "Rock density", "unit": "t/m3", "group": "Объёмы", "format": "0.00", "builtIn": true },
    { "id": "hole.tonnes", "nameRu": "Масса породы", "nameEn": "Tonnes", "unit": "t", "group": "Объёмы", "format": "0.0", "builtIn": true },
    { "id": "hole.powderFactor", "min": 0, "max": 5, "nameRu": "Удельный расход", "nameEn": "Powder factor", "unit": "kg/m3", "group": "Объёмы", "format": "0.000", "builtIn": true },
    { "id": "hole.productCost", "nameRu": "Стоимость продуктов", "nameEn": "Product cost", "unit": "?", "group": "Стоимость", "format": "0.00", "builtIn": true },
