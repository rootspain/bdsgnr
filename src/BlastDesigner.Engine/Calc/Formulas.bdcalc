    { "id": "blast.energyFactor", "nameRu": "Удельная энергия", "nameEn": "Energy factor", "unit": "MJ/t", "group": "Итоги", "format": "0.00", "builtIn": true },
    { "id": "blast.productCost", "nameRu": "Стоимость продуктов", "nameEn": "Product cost", "unit": "?", "group": "Стоимость", "format": "0.00", "builtIn": true },
    { "id": "blast.drillingCost", "nameRu": "Стоимость бурения", "nameEn": "Drilling cost", "unit": "$", "group": "Стоимость", "format": "0.00", "builtIn": true },
    { "id": "blast.loadingCost", "nameRu": "Стоимость заряжания", "nameEn": "Loading cost", "unit": "$", "group": "Стоимость", "format": "0.00", "builtIn": true },
    { "id": "blast.fixedCost", "nameRu": "Постоянные затраты", "nameEn": "Fixed cost", "unit": "$", "group": "Стоимость", "format": "0.00", "builtIn": true },
    { "id": "blast.totalCost", "nameRu": "Стоимость всего", "nameEn": "Total cost", "unit": "$", "group": "Стоимость", "format": "0.00", "builtIn": true },
    { "id": "blast.costPerTonne", "nameRu": "Стоимость тонны", "nameEn": "Cost per tonne", "unit": "$/t", "group": "Стоимость", "format": "0.000", "builtIn": true },
    { "id": "blast.avgBurden", "nameRu": "Средняя Л.С.П.", "nameEn": "Average burden", "unit": "m", "group": "Сетка", "format": "0.00", "builtIn": true },
    { "id": "blast.avgSpacing", "nameRu": "Среднее расстояние", "nameEn": "Average spacing", "unit": "m", "group": "Сетка", "format": "0.00", "builtIn": true },
    { "id": "blast.mic", "nameRu": "МВЗ", "nameEn": "Max instantaneous charge", "unit": "kg", "group": "Прогнозы", "format": "0.0", "builtIn": true },
    { "id": "blast.avgCharge", "nameRu": "Средний заряд", "nameEn": "Average charge", "unit": "kg", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.avgRws", "nameRu": "Средняя относительная сила", "nameEn": "Average RWS", "unit": "%", "group": "Фрагментация", "format": "0", "builtIn": true },
    { "id": "blast.avgChargeLength", "nameRu": "Средняя длина заряда", "nameEn": "Average charge length", "unit": "m", "group": "Фрагментация", "format": "0.00", "builtIn": true },
    { "id": "blast.avgBenchHeight", "nameRu": "Средняя высота", "nameEn": "Average bench height", "unit": "m", "group": "Фрагментация", "format": "0.00", "builtIn": true },
    { "id": "blast.avgDiameter", "nameRu": "Средний диаметр", "nameEn": "Average diameter", "unit": "mm", "group": "Фрагментация", "format": "0", "builtIn": true },
    { "id": "blast.fragBurden", "nameRu": "Л.С.П. для фрагментации", "nameEn": "Burden (fragmentation)", "unit": "m", "group": "Фрагментация", "format": "0.00", "builtIn": true },
    { "id": "blast.fragSpacing", "nameRu": "Расстояние для фрагментации", "nameEn": "Spacing (fragmentation)", "unit": "m", "group": "Фрагментация", "format": "0.00", "builtIn": true },
    { "id": "blast.rockFactor", "nameRu": "Фактор породы A", "nameEn": "Rock factor A", "unit": "?", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.x50", "min": 0, "max": 500, "nameRu": "Средний кусок X50", "nameEn": "Mean size X50", "unit": "cm", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.uniformity", "nameRu": "Показатель однородности n", "nameEn": "Uniformity index n", "unit": "1", "group": "Фрагментация", "format": "0.00", "builtIn": true },
    { "id": "blast.x20", "nameRu": "X20", "nameEn": "X20", "unit": "cm", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.x80", "nameRu": "X80", "nameEn": "X80", "unit": "cm", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.oversizePct", "nameRu": "Негабарит", "nameEn": "Oversize", "unit": "%", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.finesPct", "nameRu": "Мелочь", "nameEn": "Fines", "unit": "%", "group": "Фрагментация", "format": "0.0", "builtIn": true },
    { "id": "blast.flyrockMax", "nameRu": "Наибольший разлёт", "nameEn": "Max flyrock throw", "unit": "m", "group": "Разлёт", "format": "0", "builtIn": true },
    { "id": "blast.flyrockClearance", "nameRu": "Опасная зона по разлёту", "nameEn": "Flyrock clearance", "unit": "m", "group": "Разлёт", "format": "0", "builtIn": true },
    { "id": "blast.micOrMaxCharge", "nameRu": "Заряд для опасной зоны", "nameEn": "Charge for exclusion zone", "unit": "kg", "group": "Опасная зона", "format": "0.0", "builtIn": true },
    { "id": "blast.vibrationRadius", "nameRu": "Радиус по сейсмике", "nameEn": "Vibration radius", "unit": "m", "group": "Опасная зона", "format": "0", "builtIn": true },
    { "id": "blast.airblastRadius", "nameRu": "Радиус по воздушной волне", "nameEn": "Airblast radius", "unit": "m", "group": "Опасная зона", "format": "0", "builtIn": true },
    { "id": "blast.exclusionRadius", "nameRu": "Радиус опасной зоны", "nameEn": "Exclusion radius", "unit": "m", "group": "Опасная зона", "format": "0", "builtIn": true },

    { "id": "monitor.distance", "nameRu": "До ближайшего заряда", "nameEn": "Distance to nearest charge", "unit": "m", "group": "Сейсмика", "format": "0", "builtIn": true },
    { "id": "monitor.ppv", "nameRu": "Скорость колебаний (по МВЗ)", "nameEn": "PPV (from MIC)", "unit": "?", "group": "Сейсмика", "format": "0.0", "builtIn": true },
    { "id": "monitor.airblastDb", "nameRu": "Воздушная волна (по МВЗ)", "nameEn": "Airblast (from MIC)", "unit": "dB", "group": "Сейсмика", "format": "0", "builtIn": true },
    { "id": "monitor.ppvPredicted", "nameRu": "Скорость колебаний (по окнам)", "nameEn": "PPV (by delay windows)", "unit": "?", "group": "Сейсмика", "format": "0.0", "builtIn": true }
  ],
  "formulas": [
    { "property": "deck.mass", "onError": 0, "source": "Charging.DeckMass",
      "comment": "Газовый мешок — 0; патронированное ВВ — целые патроны; иначе объём колонки × плотность × коэффициент заряжания (только ВВ). Без продукта — 0.",
      "expression": "if(product.kind = 'GasBag', 0, if(product.kind = 'PackagedExplosive' and product.unitLength > 0 and product.unitMass > 0, floor(length / product.unitLength + 1e-9) * product.unitMass, pi * (to(m, hole.diameter) / 2) ^ 2 * length * to(kg/m3, product.density) * if(product.isExplosive, hole.loadingFactor, 1)))" },
    { "property": "deck.kgPerMetre", "source": "Flyrock.Compute", "expression": "if(length > 0, mass / length, 0)" },
    { "property": "deck.energy", "source": "Quantities.Compute", "expression": "if(product.isExplosive, mass * product.energy, 0)", "onError": 0 },
    { "property": "deck.isExplosive", "source": "Product.IsExplosive", "expression": "product.isExplosive" },

    { "property": "hole.chargeMass", "source": "Charging.ExplosiveMass", "expression": "sum(decks where product.isExplosive, mass) + sum(primers, coalesce(booster.unitMass, 0))" },
    { "property": "hole.explosiveLength", "source": "Fragmentation.Compute", "expression": "sum(decks where product.isExplosive, length)" },
    { "property": "hole.stemmingLength", "source": "Charging.StemmingLength", "expression": "sum(decks where product.kind = 'Stemming', length)" },
    { "property": "hole.topStemming", "source": "Charging.TopStemming", "comment": "От устья до первого интервала не забойки; без таких — вся длина.", "expression": "coalesce(first(decks where product.kind <> 'Stemming', top), effectiveLength)" },
    { "property": "hole.explosiveEnergy", "source": "Quantities.Compute", "expression": "sum(decks, energy)" },
    { "property": "hole.isLoaded", "expression": "count(decks) > 0" },
    { "property": "hole.hasExplosive", "expression": "count(decks where product.isExplosive) > 0" },
    { "property": "hole.area", "source": "Quantities.VoronoiAreas", "comment": "Ячейка Вороного по всем скважинам взрыва в границе; вне ячеек — Л.С.П. × расстояние.", "expression": "cellArea()" },
    { "property": "hole.benchHeight", "source": "Quantities.Compute", "expression": "max(0, (length - subdrill) * max(0.05, cos(angle)))" },
    { "property": "hole.volume", "source": "Quantities.Compute", "expression": "area * benchHeight" },
    { "property": "hole.rockDensity", "source": "Quantities.Compute", "expression": "coalesce(material.density, blast.rockDensity)" },
    { "property": "hole.tonnes", "source": "Quantities.Compute", "expression": "volume * rockDensity" },
    { "property": "hole.powderFactor", "expression": "if(volume > 0, chargeMass / volume, 0)" },
    { "property": "hole.productCost", "source": "Quantities.Compute", "comment": "Газовый мешок считается штукой, остальное в колонке — по массе; боевики и детонаторы — штуками.",
      "expression": "sum(decks where exists(product), if(product.kind = 'GasBag', 1, mass) * product.cost + sum(primers, coalesce(booster.cost, 0) + coalesce(detonator.cost, 0)))" },
    { "property": "hole.kgPerMetre", "source": "Flyrock.Compute", "onError": 0, "expression": "max(decks where product.isExplosive, kgPerMetre)" },
    { "property": "hole.explosiveTop", "source": "Flyrock.Compute", "expression": "min(decks where product.isExplosive, top)" },
    { "property": "hole.flyrockBurden", "source": "Flyrock.Compute", "comment": "До бровки, если она есть, иначе проектная Л.С.П.", "expression": "coalesce(distToLine(Crest), blast.burden)" },
    { "property": "hole.faceBurst", "source": "Flyrock.FaceBurst (Richards & Moore)",
      "expression": "if(exists(distToLine(Crest)), if(flyrockBurden <= 0, 0, param(site.flyrock.K) ^ 2 / 9.81 * (sqrt(kgPerMetre) / flyrockBurden) ^ 2.6), 0)" },
    { "property": "hole.cratering", "source": "Flyrock.Cratering (Richards & Moore)",
      "expression": "if(explosiveTop <= 0, inf, param(site.flyrock.K) ^ 2 / 9.81 * (sqrt(kgPerMetre) / explosiveTop) ^ 2.6)" },
    { "property": "hole.rifling", "source": "Flyrock.Rifling (Richards & Moore)", "expression": "cratering * abs(sin(2 * (90 - angle)))" },
    { "property": "hole.flyrockMax", "source": "Flyrock.HoleResult.Max", "expression": "max(faceBurst, max(cratering, rifling))" },

    { "property": "blast.holeCount", "expression": "count(holes where not isDummy)" },
    { "property": "blast.dummyCount", "expression": "count(holes where isDummy)" },
    { "property": "blast.loadedCount", "expression": "count(holes where not isDummy and isLoaded)" },
    { "property": "blast.drilledMetres", "source": "Quantities.Compute", "expression": "sum(holes where not isDummy, effectiveLength)" },
    { "property": "blast.volume", "source": "Quantities.Compute", "expression": "sum(holes where not isDummy, volume)" },
    { "property": "blast.tonnes", "source": "Quantities.Compute", "expression": "sum(holes where not isDummy, tonnes)" },
    { "property": "blast.explosiveKg", "source": "Quantities.Compute", "expression": "sum(holes where not isDummy, chargeMass)" },
    { "property": "blast.explosiveEnergy", "source": "Quantities.Compute", "expression": "sum(holes where not isDummy, explosiveEnergy)" },
    { "property": "blast.powderFactor", "source": "QuantityReport.PowderFactorKgM3", "expression": "if(volume > 0, explosiveKg / volume, 0)" },
    { "property": "blast.powderFactorKgT", "source": "QuantityReport.PowderFactorKgT", "expression": "if(tonnes > 0, explosiveKg / tonnes, 0)" },
    { "property": "blast.energyFactor", "source": "Quantities.Compute", "expression": "if(tonnes > 0, explosiveEnergy / tonnes, 0)" },
    { "property": "blast.productCost", "source": "Quantities.Compute", "expression": "sum(holes where not isDummy, productCost) + sum(ties, coalesce(product.cost, 0))" },
    { "property": "blast.drillingCost", "source": "Quantities.Compute", "expression": "drilledMetres * drillingPerMetre" },
    { "property": "blast.loadingCost", "source": "Quantities.Compute", "expression": "loadedCount * loadingPerHole" },
    { "property": "blast.fixedCost", "source": "Quantities.Compute", "expression": "labourPerBlast + otherFixed" },
    { "property": "blast.totalCost", "source": "QuantityReport.TotalCost", "expression": "productCost + drillingCost + loadingCost + fixedCost" },
    { "property": "blast.costPerTonne", "source": "QuantityReport.CostPerTonne", "expression": "if(tonnes > 0, totalCost / tonnes, 0)" },
    { "property": "blast.avgBurden", "source": "Quantities.PatternEstimate", "expression": "patternBurden()" },
    { "property": "blast.avgSpacing", "source": "Quantities.PatternEstimate", "expression": "patternSpacing()" },
    { "property": "blast.mic", "source": "Timing.MaxInstantaneousCharge", "expression": "mic()" },

    { "property": "blast.avgCharge", "source": "Fragmentation.Compute", "expression": "if(loadedCount > 0, avg(holes where not isDummy and isLoaded, chargeMass), 0)" },
    { "property": "blast.avgRws", "source": "Fragmentation.Compute",
      "expression": "if(count(decks where not hole.isDummy and product.isExplosive) > 0, sum(decks where not hole.isDummy and product.isExplosive, product.relativeWeightStrength * length) / max(1e-9, sum(decks where not hole.isDummy and product.isExplosive, length)), 100)" },
    { "property": "blast.avgChargeLength", "source": "Fragmentation.Compute", "expression": "if(loadedCount > 0, avg(holes where not isDummy and isLoaded, explosiveLength), 0)" },
    { "property": "blast.avgBenchHeight", "source": "Fragmentation.Compute", "expression": "if(holeCount > 0, avg(holes where not isDummy, max(0.1, length - subdrill) * cos(angle)), benchHeight)" },
    { "property": "blast.avgDiameter", "source": "Fragmentation.Compute", "expression": "if(holeCount > 0, avg(holes where not isDummy, diameter), diameter)" },
    { "property": "blast.fragBurden", "source": "Fragmentation.Compute", "expression": "if(avgBurden > 0, avgBurden, burden)" },
    { "property": "blast.fragSpacing", "source": "Fragmentation.Compute", "expression": "if(avgSpacing > 0, avgSpacing, spacing)" },
    { "property": "blast.rockFactor", "source": "Fragmentation.RockFactor (Cunningham)",
      "expression": "if(param(site.frag.rockFactorSet) <> 0 or param(site.frag.rockFactor) > 0, clamp(param(site.frag.rockFactor), 0, 25), clamp(0.06 * (param(site.frag.rockMassDescription) + param(site.frag.jointFactor) + (25 * rockDensity - 50) + if(param(site.frag.youngsModulus) < 50, param(site.frag.youngsModulus) / 3, param(site.frag.ucs) / 5)), 0, 25))" },
    { "property": "blast.x50", "source": "Fragmentation.X50 (Kuz-Ram)",
      "expression": "if(powderFactor <= 0 or avgCharge <= 0, 0, rockFactor * powderFactor ^ -0.8 * avgCharge ^ (1 / 6) * (115 / avgRws) ^ (19 / 30))" },
    { "property": "blast.uniformity", "source": "Fragmentation.Uniformity (Cunningham)",
      "expression": "if(powderFactor <= 0 or avgCharge <= 0, 0, if(fragBurden <= 0 or avgDiameter <= 0 or avgBenchHeight <= 0, 1, clamp((2.2 - 14 * fragBurden / avgDiameter) * sqrt((1 + fragSpacing / fragBurden) / 2) * (1 - param(site.frag.drillDeviation) / fragBurden) * 1.1 ^ 0.1 * (avgChargeLength / avgBenchHeight), 0.5, 3)))" },
    { "property": "blast.x20", "source": "Fragmentation.SizeAt", "expression": "if(powderFactor <= 0 or avgCharge <= 0, 0, x50 * (ln(1 / (1 - 0.2)) / 0.693) ^ (1 / uniformity))" },
    { "property": "blast.x80", "source": "Fragmentation.SizeAt", "expression": "if(powderFactor <= 0 or avgCharge <= 0, 0, x50 * (ln(1 / (1 - 0.8)) / 0.693) ^ (1 / uniformity))" },
    { "property": "blast.oversizePct", "source": "Fragmentation.RosinRammler",
      "expression": "if(powderFactor <= 0 or avgCharge <= 0, 0, 100 * (1 - (1 - exp(-0.693 * (param(site.frag.oversize) / x50) ^ uniformity))))" },
    { "property": "blast.finesPct", "source": "Fragmentation.RosinRammler",
      "expression": "if(powderFactor <= 0 or avgCharge <= 0, 0, 100 * (1 - exp(-0.693 * (param(site.frag.fines) / x50) ^ uniformity)))" },
    { "property": "blast.flyrockMax", "source": "Flyrock.Compute", "expression": "if(count(holes where not isDummy and hasExplosive) > 0, max(holes where not isDummy and hasExplosive, flyrockMax), 0)" },
    { "property": "blast.flyrockClearance", "source": "Flyrock.Compute", "expression": "max(param(site.flyrock.minClearance), flyrockMax * param(site.flyrock.safetyFactor))" },
    { "property": "blast.micOrMaxCharge", "source": "ExclusionZone.Compute", "comment": "Без замедлений — наибольший заряд скважины.", "expression": "if(mic > 0, mic, if(count(holes) > 0, max(holes, chargeMass), 0))" },
    { "property": "blast.vibrationRadius", "source": "SiteLaw.DistanceForPpv", "expression": "sqrt(max(0, micOrMaxCharge)) * (param(site.vib.K) / param(site.vib.ppvLimit)) ^ (1 / param(site.vib.B))" },
    { "property": "blast.airblastRadius", "source": "SiteLaw.DistanceForAirblast",
      "expression": "cbrt(max(0, micOrMaxCharge)) * (param(site.vib.airK) / (20e-6 * 10 ^ (param(site.vib.airblastLimit) / 20) / 1000)) ^ (1 / param(site.vib.airB))" },
    { "property": "blast.exclusionRadius", "source": "ExclusionZone.Result.Radius", "expression": "max(vibrationRadius, max(airblastRadius, flyrockClearance))" },

    { "property": "monitor.distance", "comment": "До устья ближайшей заряженной скважины.", "expression": "nearestChargeDistance()" },
    { "property": "monitor.ppv", "source": "Vibration.Ppv", "comment": "Оценка по МВЗ и ближайшему заряду.",
      "expression": "if(blast.mic <= 0 or distance <= 0, 0, param(site.vib.K) * (distance / sqrt(blast.mic)) ^ (-param(site.vib.B)))" },
    { "property": "monitor.airblastDb", "source": "Vibration.AirblastKPa, KPaToDb",
      "expression": "if(blast.mic <= 0 or distance <= 0, 0, 20 * log10(param(site.vib.airK) * (distance / cbrt(blast.mic)) ^ (-param(site.vib.airB)) * 1000 / 20e-6))" },
    { "property": "monitor.ppvPredicted", "source": "Vibration.Predict", "comment": "Худшее окно замедлений: заряды, сработавшие в окне МВЗ.", "expression": "predictPpv()" }
  ]
}
