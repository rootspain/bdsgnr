    { "id": "hole.explosiveLength", "nameRu": "Длина заряда", "nameEn": "Charge length", "unit": "m", "group": "Заряжание", "format": "0.00", "builtIn": true },
    { "id": "hole.stemmingLength", "nameRu": "Длина забойки", "nameEn": "Stemming length", "unit": "m", "group": "Заряжание", "format": "0.00", "builtIn": true },
