    { "id": "blast.powderFactor", "min": 0, "max": 5, "nameRu": "Удельный расход, кг/м³", "nameEn": "Powder factor kg/m³", "unit": "kg/m3", "group": "Итоги", "format": "0.000", "builtIn": true },
