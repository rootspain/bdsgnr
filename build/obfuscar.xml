<?xml version="1.0" encoding="utf-8"?>
<!--
  Obfuscation for the distributable build: the app (BlastDesigner.dll) and the calculation libraries (Domain, Engine, IO,
  Rendering, Recognition), processed in one run so the references between them are renamed alike. The survey
  model is an embedded resource of Recognition: kept as it is, readable by anyone who unpacks the assembly.
  Public API, properties and events keep their names: public property names are the .bdp file format (JSON), the data
  bindings and the property grid, which all find them by name. Embedded resources (ru.tsv, CHANGELOG) are kept too.
  What this does: encrypt string literals (hides the trial secret, the registry path and the messages) and rename private
  and internal types, fields and methods — the calculation code itself.
  Run with: obfuscar.console build/obfuscar.xml  (build-trial.ps1 fills in InPath/OutPath).
-->
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value="./obf" />
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="true" />
  <Var name="ReuseNames" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Module file="$(InPath)\BlastDesigner.dll" />
  <Module file="$(InPath)\BlastDesigner.Domain.dll" />
  <Module file="$(InPath)\BlastDesigner.Engine.dll" />
  <Module file="$(InPath)\BlastDesigner.IO.dll" />
  <Module file="$(InPath)\BlastDesigner.Rendering.dll" />
  <Module file="$(InPath)\BlastDesigner.Recognition.dll" />
</Obfuscator>
